---
import { Image } from 'astro:assets';
import '../styles/landing.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import architectureImage from '../assets/Mininet-Iplab-Architecture.svg';
import ospfShot from '../assets/screenshots/lab-ospf-lab.png';
import captureShot from '../assets/screenshots/dhcp-capture.png';
import natShot from '../assets/screenshots/nat-table.png';
import resolverShot from '../assets/screenshots/resolver-cache.png';
import linkShot from '../assets/screenshots/link-condition-modal.png';
import relayShot from '../assets/screenshots/dhcp-relay-paths.png';
import { latestVersion } from '../versions';

const gallery = [
  {
    image: ospfShot,
    title: 'Routing you can watch converge',
    text: 'Nine OSPF Routers in three areas, drawn from the authored Layout.',
    href: '/docs/features/ospf/',
    alt: 'The OSPF Routing Lab in Web UI Mode: nine Routers, three switches, and six Hosts',
  },
  {
    image: captureShot,
    title: 'Packet Capture in the browser',
    text: 'Watch Discover, Offer, Request, and ACK arrive while the client runs.',
    href: '/docs/features/packet-capture/',
    alt: 'A DHCP Packet Capture on r1-eth0 with the Offer decoded field by field',
  },
  {
    image: relayShot,
    title: 'Services on real daemons',
    text: 'Kea DHCP with Relays, Knot DNS, and an Unbound Resolver on Lab Nodes.',
    href: '/docs/features/dhcp-relay/',
    alt: 'The DHCP Relay Lab with DHCP RELAY badges on two Routers and the central Service on r1',
  },
  {
    image: resolverShot,
    title: 'Service panels for every Service',
    text: 'Inspect a Resolver cache, edit DNS Records, or change a DHCP Pool live.',
    href: '/docs/features/dns-resolver/',
    alt: 'The Recursive Caching Resolver Cache Inspector with hit counters and cached delegations',
  },
  {
    image: natShot,
    title: 'NAT you can see',
    text: 'The NAT Table lists each translated connection as it is created and expires.',
    href: '/docs/features/nat/',
    alt: 'The NAT Table for r1 showing two translated ICMP connections',
  },
  {
    image: linkShot,
    title: 'Link Conditions on demand',
    text: 'Add delay, loss, or a bandwidth limit to any Link without touching the Topology.',
    href: '/docs/features/link-conditions/',
    alt: 'The Configure Link dialog with bandwidth, delay, and loss filled in',
  },
];

const paths = [
  {
    title: 'Check the prerequisites',
    text: 'Prepare a Linux-capable host, Docker, and Open vSwitch before you start a Lab.',
    href: '/docs/getting-started/prerequisites/',
    label: 'Check the prerequisites',
  },
  {
    title: 'Run the Quick Start',
    text: 'Start the canonical static-routing Lab, prove traffic crosses it, and shut it down cleanly.',
    href: '/docs/getting-started/quickstart/',
    label: 'Open the Quick Start',
  },
  {
    title: 'Create a Lab',
    text: 'Turn a networking lesson into a Python Lab Example with the right Nodes, Links, and Guide.',
    href: '/docs/build-labs/',
    label: 'Learn how to create a Lab',
  },
  {
    title: 'Browse the Lab Examples',
    text: 'See all 23 Lab Examples that ship with the core, each with a screenshot of it running.',
    href: '/docs/lab-examples/',
    label: 'Open the Lab Example catalog',
  },
  {
    title: 'Add a feature',
    text: 'Use copyable patterns for routing, DHCP, DNS, VLANs, NAT, containers, and Web UI observation.',
    href: '/docs/features/',
    label: 'Browse feature recipes',
  },
  {
    title: 'Run a classroom',
    text: 'Start one Lab for an Instructor and Learners with mniplab serve and role-based .env accounts.',
    href: '/docs/getting-started/classroom/',
    label: 'Open classroom deployment',
  },
  {
    title: 'Contribute to the project',
    text: 'See how the core framework and the documentation site fit together, then find the right place to help.',
    href: '/docs/contribute/',
    label: 'Read contribution guidance',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Mininet-IPLab is a network emulation framework for teaching IP routing and core network services on top of Mininet."
    />
    <link rel="icon" href="/favicon.svg" />
    <title>Mininet-IPLab · Network emulation for IP teaching</title>
  </head>
  <body>
    <SiteHeader current="home" />

    <main>
      <section class="hero shell" aria-labelledby="hero-title">
        <div class="hero-copy">
          <h1 id="hero-title"><span>A routing lab for every group.</span> <span>One Linux host for the whole class.</span></h1>
          <p class="hero-lede">
            Mininet-IPLab is a network emulation framework for teaching IP routing and core network services on top of
            Mininet. Run a Lab from the CLI or browser, inspect what happens, and connect the behavior to the lesson.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="/docs/getting-started/prerequisites/">Start with prerequisites <span aria-hidden="true">↗</span></a>
            <a class="button button-secondary" href="/docs/getting-started/quickstart/">Run the Quick Start</a>
          </div>
        </div>
        <figure class="hero-demo">
          <div class="demo-frame">
            <img
              src="/mininet-iplab-demo.gif"
              alt="Mininet-IPLab Web UI showing a running Lab with a topology and browser terminals"
              width="1280"
              height="720"
              loading="eager"
              decoding="async"
            />
          </div>
          <figcaption>
            <strong>Web UI Mode</strong>
            <span>Running Lab demo</span>
          </figcaption>
        </figure>
      </section>

      <!-- <section class="overview shell" id="overview" aria-labelledby="overview-title">
        <div class="overview-grid">
          <h2 id="overview-title">A practical way to teach how networks behave.</h2>
          <p>
            Instructors create Lab Examples. Learners run and inspect the resulting Labs. Contributors extend the core
            framework and the documentation around it. The site gives each audience a clear place to begin.
          </p>
        </div>
      </section> -->

      <section class="architecture shell" id="architecture" aria-labelledby="architecture-title">
        <div class="section-heading">
          <h2 id="architecture-title">How the system fits together.</h2>
          <p>
            Mininet-IPLab extends Mininet with Open vSwitch, routing software, and network Services on a single Linux
            host. Instructors and Learners interact with a Lab through CLI Mode or the optional Web UI Mode.
          </p>
        </div>
        <figure class="architecture-figure">
          <img
            src={architectureImage.src}
            alt="Four-layer Mininet-IPLab architecture: Python Labs, CLI and Web UI connect to running Labs with routers, switches, hosts and network Services on a Linux host."
            width="1200"
            height="840"
            loading="lazy"
            decoding="async"
          />
          <figcaption>
            A Lab runs on one Linux host, combining Mininet with the routing and network-service software that makes
            network behavior observable.
          </figcaption>
        </figure>
      </section>

      <section class="gallery shell" id="gallery" aria-labelledby="gallery-title">
        <div class="section-heading">
          <h2 id="gallery-title">See a Lab running.</h2>
          <p>
            Every screenshot is a real Lab Example from the core repository, running in Web UI Mode. The Lab Example
            catalog has one for each of the 23 Labs.
          </p>
        </div>
        <ul class="gallery-grid">
          {gallery.map((item) => (
            <li>
              <a class="gallery-item" href={item.href}>
                <Image src={item.image} alt={item.alt} widths={[480, 720, 960]} sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 360px" loading="lazy" />
                <strong>{item.title}</strong>
                <span>{item.text}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="gallery-more"><a href="/docs/lab-examples/">Browse all Lab Examples <span aria-hidden="true">→</span></a></p>
      </section>

      <section class="paths shell" aria-labelledby="paths-title">
        <div class="section-heading">
          <h2 id="paths-title">Choose a starting point.</h2>
          <p>Use the path that matches what you are trying to do.</p>
        </div>
        <div class="path-list">
          {paths.map((path) => (
            <a class="path" href={path.href}>
              <strong>{path.title}</strong>
              <span>{path.text}</span>
              <span class="path-link">{path.label} <span aria-hidden="true">→</span></span>
            </a>
          ))}
        </div>
      </section>

      <section class="status-band" aria-labelledby="status-title">
        <div class="shell status-content">
          <h2 id="status-title">Documentation for every release.</h2>
          <p>
            The documentation describes Mininet-IPLab <code>{latestVersion.id}</code>. Use the version selector beside the
            site title in the docs to switch releases; each version links to the matching core source.
          </p>
        </div>
      </section>
    </main>

    <SiteFooter />

  </body>
</html>
