---
// Mininet-IPLab v0.1.0 at the top level: who uses it, the two layers they go
// through, the Group Labs, and the one host underneath. Names only; the docs
// explain each part.

const arrow = 'M10 3v13M5 11l5 5 5-5';

const groups = [
  { name: 'Group A', lab: 'OSPF' },
  { name: 'Group B', lab: 'BGP · DNS' },
  { name: 'Group C', lab: 'RPKI' },
];

const labSoftware = ['FRR', 'Open vSwitch', 'ExaBGP', 'Docker', 'Kea', 'Knot', 'Unbound', 'Krill', 'Routinator'];
const hostParts = ['Network namespaces', 'veth and tc', 'Open vSwitch', 'Docker'];
---

<figure class="arch" aria-labelledby="arch-caption">
  <div class="arch-lanes arch-actors">
    <div class="arch-actor">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2" /><path d="M7 9l3 2.5L7 14M12 14h5M8 20h8" /></svg>
      <span><strong>CLI Mode</strong> Instructor</span>
    </div>
    <div class="arch-actor">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="14" rx="2" /><path d="M3 8h18M7 21h10" /></svg>
      <span><strong>Web UI Mode</strong> Instructor and Learners</span>
    </div>
  </div>

  <div class="arch-lanes arch-flow" aria-hidden="true">
    <svg viewBox="0 0 20 20"><path d={arrow} /></svg>
    <svg viewBox="0 0 20 20"><path d={arrow} /></svg>
  </div>

  <section class="arch-layer" aria-label="Interfaces">
    <h3>Interfaces</h3>
    <ul class="arch-row">
      <li>Lab Prompt</li>
      <li>Web UI</li>
      <li>Lab Authoring</li>
      <li>Python Lab Examples</li>
    </ul>
  </section>

  <div class="arch-lanes arch-flow" aria-hidden="true">
    <svg viewBox="0 0 20 20"><path d={arrow} /></svg>
    <svg viewBox="0 0 20 20"><path d={arrow} /></svg>
  </div>

  <section class="arch-layer" aria-label="Classroom server">
    <h3>Classroom server</h3>
    <ul class="arch-row">
      <li>Lab manager</li>
      <li>Sessions and Groups</li>
      <li>Terminal Service</li>
      <li>Packet Analysis</li>
    </ul>
  </section>

  <div class="arch-lanes arch-flow" aria-hidden="true">
    <svg viewBox="0 0 20 20"><path d={arrow} /></svg>
    <svg viewBox="0 0 20 20"><path d={arrow} /></svg>
  </div>

  <section class="arch-layer" aria-label="Labs">
    <h3>Labs</h3>
    <div class="arch-labs">
      <ul class="arch-groups">
        {groups.map((group) => (
          <li><strong>{group.name}</strong><span>{group.lab}</span></li>
        ))}
      </ul>
      <ul class="arch-stack">
        {labSoftware.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="arch-layer arch-host" aria-label="One Linux host">
    <h3>One Linux host</h3>
    <ul class="arch-stack">
      {hostParts.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <figcaption id="arch-caption">
    Each Group runs its own isolated Lab, outlined in orange, side by side on one Linux host.
  </figcaption>
</figure>
