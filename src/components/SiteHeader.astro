---
interface Props {
  current?: 'home' | 'publications';
}

const { current = 'home' } = Astro.props;

// On the landing page the section links stay in-page; elsewhere they lead back to it.
const section = (id: string) => (current === 'home' ? `#${id}` : `/#${id}`);
---

<header class="site-header">
  <a class="brand" href="/" aria-label="Mininet-IPLab home">
    <img src="/mininet-iplab-mark.svg" alt="" width="36" height="36" />
    <span>Mininet-IPLab</span>
  </a>
  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
    <svg viewBox="0 0 20 20" aria-hidden="true">
      <path class="menu-line menu-line-top" d="M3 5h14" />
      <path class="menu-line menu-line-middle" d="M3 10h14" />
      <path class="menu-line menu-line-bottom" d="M3 15h14" />
    </svg>
    <span class="visually-hidden">Menu</span>
  </button>
  <nav id="site-nav" aria-label="Primary navigation">
    <a href={section('overview')}>Overview</a>
    <a href={section('architecture')}>Architecture</a>
    <a href={section('gallery')}>Screenshots</a>
    <a href="/publications/" aria-current={current === 'publications' ? 'page' : undefined}>Publications</a>
    <a href="/docs/">Documentation</a>
    {/*
      The core repository stays private until the project is published. The button
      reads "Coming soon" and is not a link until the GitHub API can see the repository;
      then it links there and shows the star count.
    */}
    <a
      class="nav-action repo-link is-pending"
      aria-disabled="true"
      aria-label="GitHub repository, coming soon"
      data-repo-link
      data-repo-href="https://github.com/mininet-iplab/mininet-iplab"
      data-repo-api="https://api.github.com/repos/mininet-iplab/mininet-iplab"
    >
      <svg class="repo-icon" viewBox="0 0 16 16" aria-hidden="true">
        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
      </svg>
      <span>GitHub</span>
      <span class="repo-stars" data-repo-stars aria-live="polite">
        <svg class="repo-star" viewBox="0 0 16 16" aria-hidden="true">
          <path d="m8 0 2.47 5.01 5.53.8-4 3.9.94 5.51L8 12.6l-4.94 2.62L4 9.71 0 5.81l5.53-.8L8 0Z" />
        </svg>
        <span data-repo-stars-value>Coming soon</span>
      </span>
    </a>
  </nav>
</header>

<script>
  const menuToggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const siteNav = document.getElementById('site-nav');

  const setMenuOpen = (open: boolean) => {
    if (!menuToggle || !siteNav) return;
    menuToggle.setAttribute('aria-expanded', String(open));
    siteNav.toggleAttribute('data-open', open);
  };

  menuToggle?.addEventListener('click', () => setMenuOpen(menuToggle.getAttribute('aria-expanded') !== 'true'));
  siteNav?.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a[href]')) setMenuOpen(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menuToggle?.getAttribute('aria-expanded') === 'true') {
      setMenuOpen(false);
      menuToggle.focus();
    }
  });
  document.addEventListener('click', (event) => {
    if (!(event.target as Element).closest('.site-header')) setMenuOpen(false);
  });
  matchMedia('(min-width: 800.02px)').addEventListener('change', () => setMenuOpen(false));

  const repositoryLink = document.querySelector<HTMLAnchorElement>('[data-repo-link]');
  const starsValue = repositoryLink?.querySelector('[data-repo-stars-value]');
  const repoHref = repositoryLink?.dataset.repoHref;
  const apiUrl = repositoryLink?.dataset.repoApi;

  if (repositoryLink && starsValue && repoHref && apiUrl) {
    const controller = new AbortController();
    const timeout = window.setTimeout(() => controller.abort(), 4000);

    fetch(apiUrl, {
      headers: { Accept: 'application/vnd.github+json' },
      signal: controller.signal,
    })
      .then((response) => {
        if (!response.ok) throw new Error(`GitHub responded with ${response.status}`);
        return response.json();
      })
      .then((repository) => {
        if (typeof repository.stargazers_count !== 'number') throw new Error('GitHub response was incomplete');

        const stars = new Intl.NumberFormat('en-US').format(repository.stargazers_count);
        repositoryLink.href = repoHref;
        repositoryLink.removeAttribute('aria-disabled');
        repositoryLink.classList.replace('is-pending', 'is-available');
        repositoryLink.setAttribute('aria-label', `GitHub repository, ${stars} stars`);
        starsValue.textContent = stars;
      })
      // A private or unreachable repository keeps the "Coming soon" state.
      .catch(() => {})
      .finally(() => window.clearTimeout(timeout));
  }
</script>
